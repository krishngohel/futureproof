# Copy this file to .env.local and fill in your values
# Never commit .env.local to git

# ── Supabase ────────────────────────────────────────────
# Get from: https://app.supabase.com → project → Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here   # Keep secret — server only

# ── Stripe ──────────────────────────────────────────────
# Get from: https://dashboard.stripe.com → Developers → API keys
STRIPE_SECRET_KEY=sk_test_...
STRIPE_PUBLISHABLE_KEY=pk_test_...

# Create 3 products in Stripe (one per plan) and paste each Price ID below
STRIPE_PRICE_ID_STARTER=price_...   # $5/month  — 50k tokens/week
STRIPE_PRICE_ID_PRO=price_...       # $12/month — 150k tokens/week + IDE
STRIPE_PRICE_ID_MAX=price_...       # $20/month — 200k tokens/week + IDE + priority

# Webhook secret — get after running: stripe listen --forward-to localhost:3000/api/stripe/webhook
STRIPE_WEBHOOK_SECRET=whsec_...

# ── App ─────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000
# For production: NEXT_PUBLIC_APP_URL=https://your-domain.vercel.app
